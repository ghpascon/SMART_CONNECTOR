{
    "dispatch_type": "post",
    "url": "http://localhost:5001/write_list/removed",
    "on_event": "remove_from_write_list",
    "allow_batches": false,
    "headers": {
        "Content-Type": "application/json"
    },
    "body": {
        "tid": "{data[tid]}",
        "epc": "{data[epc]}",
        "original_epc": "{data[original_epc]}"
    }
}